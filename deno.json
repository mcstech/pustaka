{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "deno run --env-file -A vite",
    "build": "vite build",
    "start": "deno serve --env-file -A _fresh/server.js",
    "update": "deno run --env-file -A -r jsr:@fresh/update .",
    "generate-quran": "deno run --allow-read --allow-write scripts/generate-documents.ts",
    "generate-bible": "deno run --allow-net --allow-read --allow-write scripts/generate-bible-documents.ts",
    "generate-wejangan": "deno run --allow-read --allow-write scripts/generate-wejangan-documents.ts",
    "prepare-docs": "deno run --allow-read --allow-write --allow-run scripts/prepare-docs.ts",
    "generate-og-quran": "deno run --allow-read --allow-write scripts/generate-quran-og-images.ts",
    "generate-og-bible": "deno run --allow-read --allow-write scripts/generate-bible-og-images.ts",
    "generate-og-all": "deno run --allow-read --allow-write scripts/generate-quran-og-images.ts && deno run --allow-read --allow-write scripts/generate-bible-og-images.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@deno/gfm": "jsr:@deno/gfm@^0.11.0",
    "@quranjs/api": "npm:@quranjs/api@^2.0.0",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.19",
    "clsx": "npm:clsx@^2.1.1",
    "daisyui": "npm:daisyui@^5.5.14",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "marked-smartypants": "npm:marked-smartypants@^1.1.11",
    "preact": "npm:preact@^10.27.2",
    "@preact/signals": "npm:@preact/signals@^2.5.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "tailwind-merge": "npm:tailwind-merge@^3.4.0",
    "vite": "npm:vite@^7.1.3",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
